# Public Vite client configuration.
# These values may be bundled into the patient-facing browser application.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Trusted backend configuration.
SUPABASE_URL=
# Server-side only. Never expose this value through Vite or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Robot bridge configuration. ROS2-specific settings remain on the robot.
ROBOT_ID=
ERWIN_API_BASE_URL=
